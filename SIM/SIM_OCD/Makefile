#---------------------------------------------------------------------------
# Makefile : OpenOCD co-simulation (Verilator + remote_bitbang)
#
#   make            : build and run the JTAG test (authentication off)
#   make auth       : run with authentication on (SW2 up)
#   make build      : build the Verilator model only
#   make wave       : JTAG test with VCD dump (tb_OCD.vcd)
#   make gtkwave    : open tb_OCD.vcd with tb_OCD.gtkw
#                     (.gtkw is generated by ../SIM_DBG/gen_gtkw.py)
#   make clean
#
#   OPENOCD=<path>  : OpenOCD binary (riscv-openocd)
#---------------------------------------------------------------------------

TOP     := tb_OCD
RTL_DIR := ../../RTL
OPENOCD ?= openocd
PORT    ?= 44853

RTL_SRCS := \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_CDC/DBG_CDC.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_CJTAG/DBG_CJTAG.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_DTM/DBG_DTM.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_DM/DBG_DM.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_HART_STUB/DBG_HART_STUB.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_BUSMST/DBG_BUSMST.sv \
	$(RTL_DIR)/CPU/CPU_DBG/CPU_DBG/CPU_DBG.sv \
	$(RTL_DIR)/CPU/CPU_DBG/DBG_CACHE/DBG_CACHE.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/CACHE_TAG_ARRAY/CACHE_TAG_ARRAY.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/CACHE_DATA_ARRAY/CACHE_DATA_ARRAY.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/ICACHE/ICACHE.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/DCACHE/DCACHE.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/CACHE_PORT_ARB/CACHE_PORT_ARB.sv \
	$(RTL_DIR)/CPU/CPU_CACHE/CPU_CACHE/CPU_CACHE.sv \
	$(RTL_DIR)/BUS/BUS_ARB/BUS_ARB.sv \
	$(RTL_DIR)/BUS/AXI4_ADDR_NARROW/AXI4_ADDR_NARROW.sv \
	$(RTL_DIR)/BUS/AXIL_ADDR_NARROW/AXIL_ADDR_NARROW.sv \
	$(RTL_DIR)/BUS/AXI4_RAM/AXI4_RAM.sv \
	$(RTL_DIR)/BUS/AXIL_RAM/AXIL_RAM.sv \
	$(RTL_DIR)/CPU/CPU_BFM/CPU_BFM.sv \
	$(RTL_DIR)/CPU/CPU_TOP/CPU_TOP.sv \
	$(RTL_DIR)/TOP/TOP.sv

VERILATOR_FLAGS := --binary --timing -j 0 --top-module $(TOP) \
                   -Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-UNUSEDSIGNAL \
                   -Wno-UNUSEDPARAM -Wno-DECLFILENAME -Wno-MULTIDRIVEN \
                   -Wno-SYNCASYNCNET -Wno-PINCONNECTEMPTY -Wno-LATCH

.PHONY: all build run auth wave gtkwave clean

all: run

obj_dir/V$(TOP): $(RTL_SRCS) $(TOP).sv jtag_rbb.cpp
	verilator $(VERILATOR_FLAGS) $(RTL_SRCS) $(TOP).sv jtag_rbb.cpp

build: obj_dir/V$(TOP)

# simulation in the background, OpenOCD in the foreground
run: build
	./obj_dir/V$(TOP) +port=$(PORT) > sim.log 2>&1 &
	sleep 2
	$(OPENOCD) -f openocd_sim.cfg -c "remote_bitbang port $(PORT)" -f test_ocd.tcl 2>&1 | tee openocd.log
	@grep -q "OPENOCD TEST RESULT : PASS" openocd.log

auth: build
	./obj_dir/V$(TOP) +port=$(PORT) +auth=1 > sim.log 2>&1 &
	sleep 2
	AUTH=1 $(OPENOCD) -f openocd_sim.cfg -c "remote_bitbang port $(PORT)" -f test_ocd.tcl 2>&1 | tee openocd_auth.log
	@grep -q "OPENOCD TEST RESULT : PASS" openocd_auth.log

obj_trace/V$(TOP): $(RTL_SRCS) $(TOP).sv jtag_rbb.cpp
	verilator $(VERILATOR_FLAGS) --trace -DDUMP_VCD -Mdir obj_trace $(RTL_SRCS) $(TOP).sv jtag_rbb.cpp

wave: obj_trace/V$(TOP)
	./obj_trace/V$(TOP) +port=$(PORT) > sim.log 2>&1 &
	sleep 2
	$(OPENOCD) -f openocd_sim.cfg -c "remote_bitbang port $(PORT)" -f test_ocd.tcl 2>&1 | tee openocd.log
	@sleep 1
	@grep -q "OPENOCD TEST RESULT : PASS" openocd.log

gtkwave:
	gtkwave tb_OCD.vcd tb_OCD.gtkw &

clean:
	rm -rf obj_dir obj_trace tb_OCD.vcd sim.log openocd.log openocd_auth.log image.bin
