# reference only (not pushed)
LitexRocket/

# LiteX SoC build output (regenerate with LitexSystem/scripts/build_soc.sh)
LitexSystem/build/
LitexSystem/software/boot/*.bin
LitexSystem/software/*.dtb
__pycache__/

# simulation build artifacts
obj_dir/
obj_*/
bug_work/
sweep_work/
*.vvp
*.vcd
*.marks
cache_test_image.bin
*.log
*.jou

# Vivado implementation artifacts
# (TOP.bit / TOP.bin and the *.rpt reports are kept)
FPGA/*/output/*.dcp
FPGA/*/output/*.backup.*

# test programs built from the .S files
SIM/*/tests/*.elf
SIM/*/tests/*.bin
SIM/*/tests/*.hex
SIM/*/tests/*.dis

# riscv-tests built into SIM/SIM_CORE/rvtests (the repository itself is not
# part of this project)
SIM/*/rvtests/

# SIM_FPU is built against Berkeley SoftFloat, which lives outside the project
SIM/SIM_FPU/obj_dir/
SIM/SIM_BIOS/bios.hex
SIM/SIM_BIOS/fw_jump.hex
SIM/SIM_BIOS/Image.hex
SIM/SIM_SYS/progs/*.elf
SIM/SIM_SYS/progs/*.bin
SIM/SIM_SYS/progs/*.hex
SIM/SIM_SYS/progs/*.dis
